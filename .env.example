# Copy to .env. Defaults work with `docker compose up`.
DATABASE_URL=postgresql+psycopg://ironpay:ironpay@localhost:5432/ironpay
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
# Token bucket limits (tokens per second refill, bucket size)
TRANSFER_RATE_PER_SEC=5
TRANSFER_BURST=20
